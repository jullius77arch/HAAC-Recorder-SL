<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest"
         xmlns:m2="http://schemas.microsoft.com/appx/2013/manifest"
         xmlns:m3="http://schemas.microsoft.com/appx/2014/manifest"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest">

  <Identity Name="d0eaea1b-4fd2-4438-908a-9a0dc48d4e07"
            Publisher="CN=Windows10"
            Version="1.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="2d517c02-e2d9-4873-a160-efa031f9e696"
                    PhonePublisherId="8f557300-ee8a-49cb-b7e7-b3ec8c68501a"/>

  <Properties>
    <DisplayName>HAAC Recorder</DisplayName>
    <PublisherDisplayName>Windows10</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Prerequisites>
    <OSMinVersion>6.3.1</OSMinVersion>
    <OSMaxVersionTested>6.3.1</OSMaxVersionTested>
  </Prerequisites>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
                 Executable="AGHost.exe"
                 EntryPoint="MainPage.xaml">
      <m3:VisualElements
          DisplayName="HAAC Recorder"
          Square150x150Logo="Assets\SquareTile150x150.png"
          Square44x44Logo="Assets\Logo.png"
          Description="Raw 16-bit PCM recorder for Lumia HAAC microphones"
          ForegroundText="light"
          BackgroundColor="#464646">
        <m3:DefaultTile Square71x71Logo="Assets\SquareTile71x71.png"/>
        <m3:SplashScreen Image="Assets\SplashScreen.png" />
      </m3:VisualElements>

      <Extensions>
        <Extension Category="windows.backgroundTasks" EntryPoint="AgHost.BackgroundTask">
          <BackgroundTasks>
          <Task Type="systemEvent" />
          </BackgroundTasks>
        </Extension>
      </Extensions>

    </Application>
  </Applications>

  <!-- A Silverlight 8.1 project carries BOTH manifests, and they are not
       redundant. WMAppManifest.xml declares the classic ID_CAP_* capabilities
       that gate the Silverlight surface; this file declares the WinRT-style
       capabilities that gate the Windows.* APIs the app calls through
       interop.

       KnownFolders.MusicLibrary and MediaCapture are WinRT APIs, so they are
       gated here — declaring only the ID_CAP_ equivalents next door is not
       enough and produces an access-denied at runtime rather than a build
       error, which is a slow way to find out. Both are declared in both
       places on purpose. -->
  <Capabilities>
    <Capability Name="musicLibrary" />
    <DeviceCapability Name="microphone" />
  </Capabilities>

  <Extensions>
    <Extension Category="windows.activatableClass.inProcessServer">
      <InProcessServer>
        <Path>AgHostSvcs.dll</Path>
        <ActivatableClass ActivatableClassId="AgHost.BackgroundTask" ThreadingModel="both" />
      </InProcessServer>
    </Extension>
  </Extensions>

</Package>
