<phone:PhoneApplicationPage
    x:Class="HAAC_Recorder_SL.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    FontFamily="{StaticResource PhoneFontFamilyNormal}"
    FontSize="{StaticResource PhoneFontSizeNormal}"
    Foreground="{StaticResource PhoneForegroundBrush}"
    SupportedOrientations="PortraitOrLandscape" Orientation="Portrait"
    shell:SystemTray.IsVisible="True">

    <!-- Ported from the WinRT build's MainPage.xaml. The structure and the
         three rules behind it are unchanged:

           1. Nothing may terminate the process while recording.
           2. Nothing the app does may be audible - no sounds, and no system
              dialogs, since a MessageDialog is silent on most firmware but
              not guaranteed to be on all of it. Confirmation is a plain
              in-app overlay instead.
           3. No single tap may end a recording.

         The differences from the WinRT XAML are mechanical: PhoneApplicationPage
         instead of Page, SupportedOrientations instead of an AutoRotationPreferences
         call, StaticResource instead of ThemeResource, and the Phone* theme
         resource names. -->

    <Grid x:Name="LayoutRoot" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="TitlePanel" Grid.Row="0" Margin="16,17,16,8">
            <TextBlock Text="HAAC RECORDER" Style="{StaticResource PhoneTextNormalStyle}" Margin="0,0"/>
            <!-- Says what the *next* recording will use while idle, and what
                 the current one actually negotiated while running. Those are
                 different things: a take can land on a fallback mode. -->
            <TextBlock x:Name="SubtitleText" Text="16bit PCM 48kHz" Margin="0,-2,0,0"
                       FontSize="20" TextWrapping="Wrap" Opacity="0.85"/>
            <!-- Red here means ApplicationIdleDetectionMode was refused, and a
                 take will not survive the screen locking. -->
            <TextBlock x:Name="LockModeText" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- No ScrollViewer. Everything a take needs has to be reachable
             without scrolling, in both orientations, so the content is three
             named panels that OnOrientationChanged repositions:

               portrait  - head / buttons / tail stacked in one column
               landscape - head and tail in the left column, buttons in the
                           right one, because the short landscape height
                           cannot take four stacked buttons plus text.

             ApplyOrientationLayout only ever sets Grid.Row, Grid.Column,
             Grid.ColumnSpan, Margin, Height and FontSize. It never touches
             the engine or the recording file, so rotating mid-take is
             harmless. -->
        <Grid x:Name="ContentGrid" Grid.Row="1" Margin="16,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel x:Name="HeadPanel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                <TextBlock x:Name="StatusText" Text="Ready." FontSize="26" TextWrapping="Wrap"
                           Margin="0,4,0,2"/>
                <TextBlock x:Name="FreeSpaceText" FontSize="17" TextWrapping="Wrap" Opacity="0.8"
                           Margin="0,0,0,12"/>
            </StackPanel>

            <!-- Start and Stop keep the full width of whichever column the
                 panel is in: they are the two controls that get used under
                 pressure. Settings and About share the row below at reduced
                 height, which reads as a separate group rather than a third
                 and fourth item in the same stack. -->
            <Grid x:Name="ButtonPanel" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                  VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Four rows because landscape stacks Settings and About
                     instead of sitting them side by side: in that orientation
                     the panel is only half the screen wide, and splitting it
                     again leaves each label with about a quarter of the
                     display to fit in. -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Button x:Name="StartButton" Content="Start recording"
                        Click="StartButton_Click" Height="90" FontSize="24"
                        Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalAlignment="Stretch" Margin="0,0,0,12"/>
                <Button x:Name="StopButton" Content="Stop"
                        Click="StopButton_Click" IsEnabled="False" Height="90" FontSize="24"
                        Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                        HorizontalAlignment="Stretch" Margin="0,0,0,20"/>
                <Button x:Name="SettingsButton" Content="Settings"
                        Click="SettingsButton_Click" Height="64" FontSize="18"
                        Grid.Row="2" Grid.Column="0"
                        HorizontalAlignment="Stretch" Margin="0,0,4,0"/>
                <Button x:Name="InfoButton" Content="About"
                        Click="InfoButton_Click" Height="64" FontSize="18"
                        Grid.Row="2" Grid.Column="1"
                        HorizontalAlignment="Stretch" Margin="4,0,0,0"/>
            </Grid>

            <!-- WarningText is written to only by the health check and the
                 failure paths, so an empty line here means nothing has gone
                 wrong. Both of these are capped and ellipsised: with the
                 ScrollViewer gone, an unusually long message must not be
                 able to push anything off the bottom of the screen. -->
            <StackPanel x:Name="TailPanel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                <TextBlock x:Name="WarningText" Margin="0,16,0,0" Foreground="#FFFFB900"
                           FontSize="18" TextWrapping="Wrap"
                           MaxHeight="88" TextTrimming="WordEllipsis"/>
                <TextBlock x:Name="FileInfoText" Margin="0,14,0,12"
                           FontSize="17" TextWrapping="Wrap" Opacity="0.8"
                           MaxHeight="110" TextTrimming="WordEllipsis"/>
            </StackPanel>
        </Grid>

        <!-- Stop confirmation. The layout is the accident guard: "Keep
             recording" is large and sits where the Stop button was, so a
             double-tap lands there. The destructive button is small, at the
             far bottom of the screen, and stays disabled for the first 1.2
             seconds the overlay is up. -->
        <Grid x:Name="StopConfirmOverlay" Grid.RowSpan="2" Background="Black" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="30,0,30,0">
                <TextBlock Text="Stop recording?" Foreground="White" FontSize="30" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap"/>
                <TextBlock Text="The take is still running. Nothing has been lost."
                           Foreground="Gray" FontSize="16" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,0,0,40"/>
                <Button x:Name="KeepRecordingButton" Content="Keep recording"
                        Click="KeepRecordingButton_Click"
                        HorizontalAlignment="Stretch" Height="90" FontSize="24"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="30,0,30,40">
                <TextBlock Text="Ends the take and writes the file to Music\recordings."
                           Foreground="Gray" FontSize="14" TextWrapping="Wrap"
                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <Button x:Name="ConfirmStopButton" Content="Stop and save"
                        Click="ConfirmStopButton_Click" IsEnabled="False"
                        HorizontalAlignment="Center" Width="220" FontSize="18"/>
            </StackPanel>
        </Grid>

        <!-- First-run / re-detect screen. Detection doesn't start until the
             user taps the button: verification needs actual sound in the room
             to tell a real channel apart from a duplicated one, so seizing the
             microphone unannounced tends to produce a wrong answer as well as
             a rude one. -->
        <Grid x:Name="SetupOverlay" Grid.RowSpan="2" Background="Black" Visibility="Collapsed">
            <ScrollViewer Margin="30,40,30,30">
                <StackPanel>
                    <TextBlock Text="Check what this phone can do" Foreground="White" FontSize="28"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <TextBlock x:Name="SetupStatusText" Foreground="Gray" FontSize="17" TextWrapping="Wrap"
                               Text="The app records a fraction of a second on each microphone and reads it back, to find out which ones really deliver independent channels. It takes a few seconds."
                               Margin="0,0,0,16"/>
                    <TextBlock Foreground="#FFFFB900" FontSize="16" TextWrapping="Wrap"
                               Text="Make some noise while this runs - talk, or play music. In a silent room every channel records digital zero, which is indistinguishable from a duplicate, and good microphones get rejected."
                               Margin="0,0,0,24"/>
                    <TextBlock x:Name="SetupProgressText" Foreground="White" FontSize="18"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <Button x:Name="SetupDetectButton" Content="Run detection"
                            Click="SetupDetectButton_Click" HorizontalAlignment="Stretch"
                            Height="86" FontSize="22" Margin="0,0,0,8"/>
                    <Button x:Name="SetupSkipButton" Content="Skip for now"
                            Click="SetupSkipButton_Click" HorizontalAlignment="Stretch"
                            FontSize="18"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Settings. Lists every mode this phone accepted when its microphone
             was probed, best first. Picking one overrides the automatic choice
             until "Use best available" is tapped or the app is relaunched. -->
        <Grid x:Name="SettingsOverlay" Grid.RowSpan="2" Background="Black" Visibility="Collapsed">
            <ScrollViewer Margin="30,40,30,30">
                <StackPanel>
                    <TextBlock Text="Settings" Foreground="White" FontSize="30" Margin="0,0,0,20"/>

                    <TextBlock Text="Recording mode" Foreground="White" FontSize="20" Margin="0,0,0,6"/>
                    <!-- A hand-built dropdown rather than a ComboBox. WP's
                         ComboBox abandons its inline popup above five items
                         and opens a full-screen picker page instead, and a
                         Lumia routinely detects more modes than that. This
                         one behaves the same at any count.

                         Opening it pushes the rest of Settings down rather
                         than floating over it: a Popup inside a ScrollViewer
                         has to be repositioned by hand on every scroll, and
                         getting that wrong puts the list somewhere off
                         screen. -->
                    <Button x:Name="ModePickerButton" Click="ModePickerButton_Click"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            FontSize="18" Margin="0,0,0,6"/>
                    <Border x:Name="ModePickerList" Visibility="Collapsed"
                            BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,6">
                        <ListBox x:Name="ModeListBox" SelectionChanged="ModeListBox_SelectionChanged"
                                 MaxHeight="260" FontSize="18" Margin="4"/>
                    </Border>
                    <TextBlock x:Name="ModeDeviceText" Foreground="Gray" FontSize="15"
                               TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SettingsHintText" Foreground="Gray" FontSize="15"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Button x:Name="UseBestButton" Content="Use best available"
                            Click="UseBestButton_Click" HorizontalAlignment="Stretch"
                            FontSize="18" Margin="0,0,0,8"/>
                    <Button x:Name="RedetectButton" Content="Run detection again"
                            Click="RedetectButton_Click" HorizontalAlignment="Stretch"
                            FontSize="18" Margin="0,0,0,8"/>

                    <!-- TEMPORARY. Feasibility spike for the speaker-probe
                         idea, not a shipping feature - remove this button,
                         the TextBlock below it and SpeakerProbeSpike.cs once
                         it has answered its question.

                         It lives in Settings rather than on the main screen
                         deliberately: it plays a loud tone out of the
                         loudspeaker, which is exactly the thing rule 2 of
                         this page's layout says must never happen by
                         accident near a take. -->
                    <Button x:Name="ToneOnlyButton" Content="Tone only - no capture"
                            Click="ToneOnlyButton_Click" HorizontalAlignment="Stretch"
                            FontSize="18" Margin="0,0,0,6"/>
                    <Button x:Name="SpeakerSpikeButton" Content="Speaker probe (spike)"
                            Click="SpeakerSpikeButton_Click" HorizontalAlignment="Stretch"
                            FontSize="18" Margin="0,0,0,6"/>
                    <TextBlock x:Name="SpeakerSpikeText" Foreground="Gray" FontSize="14"
                               TextWrapping="Wrap" Margin="0,0,0,24"
                               Text="Plays a tone through the speaker while recording, to find out whether the phone captures its own output. Quiet room, phone flat on a table, volume up."/>

                    <CheckBox x:Name="RunUnderLockCheckBox" Content="Keep recording under the lock screen"
                              Foreground="White" FontSize="18" Margin="0,0,0,4"
                              Checked="RunUnderLockCheckBox_Changed" Unchecked="RunUnderLockCheckBox_Changed"/>
                    <TextBlock x:Name="RunUnderLockHintText" Foreground="Gray" FontSize="14"
                               TextWrapping="Wrap" Margin="0,0,0,24"/>

                    <Button x:Name="SettingsCloseButton" Content="Close"
                            Click="SettingsCloseButton_Click" HorizontalAlignment="Stretch"
                            Height="80" FontSize="20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid x:Name="InfoOverlay" Grid.RowSpan="2" Background="Black" Visibility="Collapsed">
            <ScrollViewer Margin="30,40,30,30">
                <StackPanel>
                    <TextBlock Text="About" Foreground="White" FontSize="30" Margin="0,0,0,16"/>
                    <TextBlock Foreground="Gray" FontSize="17" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Records raw, unprocessed 16-bit PCM at 48 kHz from the high-amplitude (HAAC) microphones on Nokia Lumia handsets, straight to a WAV file in Music\recordings."/>
                    <TextBlock Foreground="Gray" FontSize="17" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="For long takes: turn on Airplane Mode so a call can't interrupt, and connect a charger. A take that reaches the 4 GB WAV limit continues automatically in a new file ending -pt2."/>
                    <TextBlock x:Name="InfoDiagnosticsText" Foreground="Gray" FontSize="15"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>
                    <Button x:Name="InfoCloseButton" Content="Close"
                            Click="InfoCloseButton_Click" HorizontalAlignment="Stretch"
                            Height="80" FontSize="20"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Visible in markup, not switched on in code. The page used to
             render once with this collapsed before MainPage_Loaded ran,
             which is what produced the flash of the recording screen before
             the splash. Code only ever hides it now. -->
        <Grid x:Name="SplashOverlay" Grid.RowSpan="2" Background="Black" Visibility="Visible">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                <!-- Four shapes, no bitmap: it stays sharp on WVGA, WXGA and
                     720p alike, and costs nothing to ship. The cradle is an
                     ellipse outline clipped to everything below y=40 in its
                     own coordinates, which leaves the arms running up either
                     side of the head. The WinRT build clipped at the ellipse's
                     midpoint, which is why its cradle was only ever a half
                     circle. -->
                <Grid Width="120" Height="150" Margin="0,0,0,28">
                    <Rectangle Width="36" Height="72" RadiusX="18" RadiusY="18"
                               Fill="{StaticResource PhoneAccentBrush}"
                               VerticalAlignment="Top" HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>
                    <Ellipse Width="72" Height="64" StrokeThickness="8"
                             Stroke="{StaticResource PhoneAccentBrush}"
                             VerticalAlignment="Top" HorizontalAlignment="Center"
                             Margin="0,28,0,0">
                        <Ellipse.Clip>
                            <RectangleGeometry Rect="0,12,72,52"/>
                        </Ellipse.Clip>
                    </Ellipse>
                    <Rectangle Width="6" Height="36"
                               Fill="{StaticResource PhoneAccentBrush}"
                               VerticalAlignment="Top" HorizontalAlignment="Center"
                               Margin="0,88,0,0"/>
                    <Rectangle Width="54" Height="8" RadiusX="4" RadiusY="4"
                               Fill="{StaticResource PhoneAccentBrush}"
                               VerticalAlignment="Top" HorizontalAlignment="Center"
                               Margin="0,124,0,0"/>
                </Grid>

                <TextBlock Text="HAAC Recorder" Foreground="White" FontSize="34"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="16bit PCM 48kHz" Foreground="Gray" FontSize="18"
                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
            </StackPanel>
        </Grid>

    </Grid>

</phone:PhoneApplicationPage>
